#. Plugin Name of the plugin
#: oli-product-feed.php
msgid "Oli Product Feed"
msgstr "Oli Product Feed"

#. Plugin URI of the plugin
#: oli-product-feed.php
msgid "https://github.com/olivierbigras/oli-product-feed"
msgstr "https://github.com/olivierbigras/oli-product-feed"

#. Description of the plugin
#: oli-product-feed.php
msgid ""
"Product feeds for WooCommerce: Google Merchant Center, Pinterest, Meta "
"(Facebook, Instagram), TikTok, Microsoft (Bing) and generic CSV/XML. One "
"feed per language and currency, TranslatePress support, background "
"generation and WP-CLI."
msgstr ""
"Flux de produits pour WooCommerce : Google Merchant Center, Pinterest, Meta "
"(Facebook, Instagram), TikTok, Microsoft (Bing) et CSV/XML générique. Un "
"flux par langue et devise, prise en charge de TranslatePress, génération en "
"arrière-plan et WP-CLI."

