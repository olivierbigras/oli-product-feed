#: src/Admin/Editor.php:1428
#, php-format
msgid "Automatic: %s"
msgstr "Automatique : %s"

#: src/Admin/Editor.php:1434
msgid "Remove"
msgstr "Retirer"

#: src/Admin/Editor.php:1442
msgid "Attribute name"
msgstr "Nom de l’attribut"

#: src/Admin/Editor.php:1445
msgid "Feed attribute to copy"
msgstr "Attribut du flux à copier"

#: src/Admin/Editor.php:1449
msgid "Prefix"
msgstr "Préfixe"

#: src/Admin/Editor.php:1450
msgid "Suffix"
msgstr "Suffixe"

#: src/Admin/Editor.php:1451
msgid "Fallback when empty"
msgstr "Repli si vide"

#: src/Admin/Editor.php:1456
msgid "Rewrite values (from=to; …)"
msgstr "Réécrire les valeurs (de=vers ; …)"

#: src/Admin/Editor.php:1461
msgid "First term"
msgstr "Premier terme"

#: src/Admin/Editor.php:1462
msgid "All terms"
msgstr "Tous les termes"

#: src/Admin/Editor.php:1463
msgid "Full path (A > B)"
msgstr "Chemin complet (A > B)"

#: src/Admin/Editor.php:1464
msgid "Top-level term"
msgstr "Terme de premier niveau"

#: src/Admin/Editor.php:1468
msgid "Terms"
msgstr "Termes"

#: src/Admin/Editor.php:1469
msgid "Use the parent value when a variation has none"
msgstr "Utiliser la valeur du parent lorsqu’une variation n’en a pas"

#: src/Admin/Editor.php:1470
msgid "Translate in the feed language"
msgstr "Traduire dans la langue du flux"

#: src/Admin/Editor.php:1471
msgid "One value only: send nothing when the product has several values"
msgstr "Une seule valeur : n’envoyer rien lorsque le produit en a plusieurs"

#: src/Admin/Editor.php:1527
msgid "Categories"
msgstr "Catégories"

#: src/Admin/Editor.php:1529
msgid "Default Google category"
msgstr "Catégorie Google par défaut"

#: src/Admin/Editor.php:1534
msgid ""
"Per product category: Google category ID and the {type} used by the title "
"template. The deepest category with a value wins."
msgstr ""
"Par catégorie de produit : ID de catégorie Google et le {type} utilisé par "
"le modèle de titre. La catégorie la plus profonde avec une valeur l’emporte."

#: src/Admin/Editor.php:1535
msgid ""
"The type is left out when the name already contains it. Words in brackets "
"are optional: \"[Guitar] Strap\" adds \"Guitar Strap\", or nothing when the "
"name already says \"Strap\"."
msgstr ""
"Le type est omis si le nom le contient déjà. Les mots entre crochets sont "
"facultatifs : « [Guitar] Strap » ajoute « Guitar Strap », ou rien si le nom "
"dit déjà « Strap »."

#: src/Admin/Editor.php:1536
msgid "Product category"
msgstr "Catégorie de produit"

#: src/Admin/Editor.php:1536 src/Admin/Editor.php:1559
msgid "Google category ID"
msgstr "ID de catégorie Google"

#: src/Admin/Editor.php:1536 src/Admin/Editor.php:1560
msgid "Type for the title"
msgstr "Type pour le titre"

#: src/Admin/Editor.php:1564
msgid "Per product"
msgstr "Par produit"

#: src/Admin/Editor.php:1564
msgid ""
"One product per line: product_id=google_category_id. Overrides the category "
"table."
msgstr ""
"Un produit par ligne : product_id=google_category_id. Remplace le tableau "
"des catégories."

#: src/Admin/Editor.php:1575
msgid "Links and images"
msgstr "Liens et images"

#: src/Admin/Editor.php:1577
msgid "HTTPS"
msgstr "HTTPS"

#: src/Admin/Editor.php:1577
msgid "Write https:// links when the site runs on https"
msgstr "Écrire des liens https:// lorsque le site tourne en https"

#: src/Admin/Editor.php:1582
msgid "UTM tags"
msgstr "Balises UTM"

#: src/Admin/Editor.php:1582
msgid "Optional. Leave empty for clean links."
msgstr "Facultatif. Laissez vide pour des liens propres."

#: src/Admin/Editor.php:1584
msgid "Parameters added to links"
msgstr "Paramètres ajoutés aux liens"

#: src/Admin/Editor.php:1587
msgid ""
"Query string of key=value pairs (for example wcpbc-manual-country=US). Added"
" to each item link (g:link) and to mobile_link when it is set. Existing "
"parameters (variation attribute_*, lang) are kept. Not added to image_link. "
"Empty: off."
msgstr ""
"Chaîne de requête de paires clé=valeur (par exemple wcpbc-manual-"
"country=US). Ajoutée au lien de chaque article (g:link) et à mobile_link "
"s’il est défini. Les paramètres déjà présents (attribute_* des variations, "
"lang) sont conservés. Non ajoutée à image_link. Vide : désactivé."

#: src/Admin/Editor.php:1589
msgid "Original file (recommended)"
msgstr "Fichier original (recommandé)"

#: src/Admin/Editor.php:1593
msgid "Image size"
msgstr "Taille d’image"

#: src/Admin/Editor.php:1594
msgid "Additional images"
msgstr "Images supplémentaires"

#: src/Admin/Editor.php:1594
msgid "gallery images at most"
msgstr "images de galerie au plus"

#: src/Admin/ActivityTable.php:239 src/Admin/Editor.php:322
#: src/Admin/Editor.php:1605
msgid "Schedule"
msgstr "Planification"

#: src/Admin/Editor.php:1608
msgid "Manually only (Generate now button or WP-CLI)"
msgstr "Manuellement seulement (bouton Générer maintenant ou WP-CLI)"

#: src/Admin/Editor.php:1609
msgid "Every hour"
msgstr "Toutes les heures"

#: src/Admin/Editor.php:1610 src/Admin/ListTable.php:367
msgid "Twice a day"
msgstr "Deux fois par jour"

#: src/Admin/Editor.php:1611
msgid "Every day"
msgstr "Tous les jours"

#: src/Admin/Editor.php:1612
msgid "Every week"
msgstr "Toutes les semaines"

#: src/Admin/Editor.php:1614 src/Admin/Editor.php:1619
msgid "Regenerate"
msgstr "Régénérer"

#: src/Admin/Editor.php:1619
msgid ""
"Runs in the background with Action Scheduler (WP-Cron when it is not "
"available)."
msgstr ""
"S’exécute en arrière-plan avec Action Scheduler (WP-Cron s’il n’est pas "
"disponible)."

#: src/Admin/Editor.php:1620
msgid "Any time"
msgstr "N’importe quand"

#: src/Admin/Editor.php:1624
msgid "Start hour"
msgstr "Heure de départ"

#: src/Admin/Editor.php:1624
msgid ""
"Daily and weekly feeds start at this hour of the site time zone (off-peak "
"hours are best)."
